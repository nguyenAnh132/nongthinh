pipeline {
    agent any
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }
    triggers {
        githubPush()
    }
    parameters {
        booleanParam(name: 'FORCE_REBUILD', defaultValue: false,
            description: 'Rebuild/deploy all components in this job even without source changes.')
        booleanParam(name: 'DEPLOY', defaultValue: true,
            description: 'Deploy frontend on VPS loopback port 8081 after build. Does not change host Nginx/TLS.')
    }
    stages {
        stage('Checkout main') {
            steps {
                git branch: 'main', credentialsId: 'nongthinh',
                    url: 'https://github.com/nguyenAnh132/nongthinh.git'
                script {
                    def commit = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG = "web-${env.BUILD_NUMBER}-${commit}"
                }
            }
        }
        stage('Detect changes since last deployment') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'nongthinh-deploy-ssh',
                    keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER')]) {
                    script {
                        env.FORCE_REBUILD = (params.FORCE_REBUILD == true).toString()
                        sh 'bash ci/plan-release.sh frontend'
                        env.HAS_CHANGES = (!readFile('selected-services.txt').trim().isEmpty()).toString()
                        if (env.HAS_CHANGES != 'true') {
                            echo 'NO_CHANGES: skipping image build and deployment.'
                        }
                    }
                }
                archiveArtifacts artifacts: 'release-plan.json,selected-services.txt', fingerprint: true
            }
        }
        stage('Build and push frontend') {
            when { expression { env.HAS_CHANGES == 'true' } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-nongthinh',
                    usernameVariable: 'DOCKERHUB_USER', passwordVariable: 'DOCKERHUB_TOKEN')]) {
                    sh 'bash ci/build-frontend.sh'
                }
                archiveArtifacts artifacts: "nongthinh-frontend-${env.IMAGE_TAG}.tar.gz", fingerprint: true
            }
        }
        stage('Deploy frontend') {
            when { expression { env.HAS_CHANGES == 'true' && (params.DEPLOY == null || params.DEPLOY) } }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'nongthinh-deploy-ssh',
                    keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER')]) {
                    sh '''
                        set +x
                        set -eu
                        remote="$DEPLOY_USER@160.250.186.236"
                        ssh -i "$DEPLOY_KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes "$remote" \
                            "mkdir -p /opt/nongthinh/releases/$IMAGE_TAG"
                        scp -i "$DEPLOY_KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes \
                            "nongthinh-frontend-$IMAGE_TAG.tar.gz" "$remote:/opt/nongthinh/releases/$IMAGE_TAG/bundle.tar.gz"
                        ssh -i "$DEPLOY_KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes "$remote" \
                            "cd /opt/nongthinh/releases/$IMAGE_TAG && tar -xzf bundle.tar.gz && bash deploy.sh"
                    '''
                }
            }
        }
    }
    post {
        success { echo "FRONTEND_RESULT: ${env.IMAGE_TAG}; changes=${env.HAS_CHANGES}; deploy=${params.DEPLOY}" }
    }
}
