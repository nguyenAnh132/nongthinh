{
  "info": {
    "_postman_id": "c8474fd4-3c72-4f47-a33e-fdb741a4f8f6",
    "name": "Agri Catalog Service",
    "description": "Postman collection kiểm thử các endpoint Product Category của agri-catalog-service.\n\nCách dùng:\n1. Import file này vào Postman.\n2. Gán JWT của tài khoản có ROLE_ADMIN vào collection variable `accessToken`.\n3. Chạy toàn bộ collection theo đúng thứ tự. Request Create sẽ tự sinh slug duy nhất và lưu `categoryId` cho các request Get/Update/Delete tiếp theo.\n\nService dev chạy trực tiếp tại http://localhost:9098/agri-catalog.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "pm.test('Response follows ApiResponse format', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.be.an('object');",
          "    pm.expect(body).to.have.property('message');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9098/agri-catalog",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categorySlug",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public Product Categories",
      "description": "Endpoint public, không yêu cầu JWT.",
      "item": [
        {
          "name": "Get Active Product Categories",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/product-categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "product-categories"
              ]
            },
            "description": "Lấy các category đang active và chưa bị soft delete."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Result is an array containing only active categories', function () {",
                  "    const result = pm.response.json().result;",
                  "    pm.expect(result).to.be.an('array');",
                  "    result.forEach(function (category) {",
                  "        pm.expect(category.active).to.eql(true);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Product Categories - CRUD Flow",
      "description": "Yêu cầu JWT có authority ROLE_ADMIN. Nên chạy cả folder theo đúng thứ tự.",
      "item": [
        {
          "name": "01 - Get All Product Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product-categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product-categories"
              ]
            },
            "description": "Lấy tất cả category chưa bị soft delete, gồm cả active và inactive."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Result is an array', function () {",
                  "    pm.expect(pm.response.json().result).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Create Product Category",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueSlug = 'postman-category-' + Date.now();",
                  "pm.collectionVariables.set('categorySlug', uniqueSlug);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Created category is returned and active by default', function () {",
                  "    const result = pm.response.json().result;",
                  "    pm.expect(result).to.be.an('object');",
                  "    pm.expect(result.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(result.name).to.eql('Danh mục kiểm thử Postman');",
                  "    pm.expect(result.slug).to.eql(pm.collectionVariables.get('categorySlug'));",
                  "    pm.expect(result.active).to.eql(true);",
                  "    pm.collectionVariables.set('categoryId', result.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": null,\n  \"name\": \"Danh mục kiểm thử Postman\",\n  \"slug\": \"{{categorySlug}}\",\n  \"description\": \"Dữ liệu tạm được tạo bởi Postman collection\",\n  \"displayOrder\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/product-categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product-categories"
              ]
            },
            "description": "Tạo category active mới. Script tự tạo slug duy nhất và lưu ID trả về vào `categoryId`."
          },
          "response": []
        },
        {
          "name": "03 - Get Product Category By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product-categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product-categories",
                "{{categoryId}}"
              ]
            },
            "description": "Lấy category vừa được tạo ở bước 02."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returned category has the requested ID', function () {",
                  "    const result = pm.response.json().result;",
                  "    pm.expect(result.id).to.eql(pm.collectionVariables.get('categoryId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Update Product Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": null,\n  \"name\": \"Danh mục kiểm thử Postman - đã cập nhật\",\n  \"slug\": \"{{categorySlug}}\",\n  \"description\": \"Dữ liệu tạm đã được cập nhật bởi Postman collection\",\n  \"displayOrder\": 1000,\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/product-categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product-categories",
                "{{categoryId}}"
              ]
            },
            "description": "Cập nhật toàn bộ category và chuyển active thành false."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Category fields are updated', function () {",
                  "    const result = pm.response.json().result;",
                  "    pm.expect(result.id).to.eql(pm.collectionVariables.get('categoryId'));",
                  "    pm.expect(result.name).to.eql('Danh mục kiểm thử Postman - đã cập nhật');",
                  "    pm.expect(result.displayOrder).to.eql(1000);",
                  "    pm.expect(result.active).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Delete Product Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product-categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product-categories",
                "{{categoryId}}"
              ]
            },
            "description": "Soft delete category vừa tạo."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Delete response has no result', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.eql('Product category deleted successfully');",
                  "    pm.expect(body.result).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Verify Deleted Category Is Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product-categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product-categories",
                "{{categoryId}}"
              ]
            },
            "description": "Xác nhận soft-deleted category không còn được truy xuất."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Product category not found error is returned', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('NOT_FOUND_PRODUCT_CATEGORY_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
