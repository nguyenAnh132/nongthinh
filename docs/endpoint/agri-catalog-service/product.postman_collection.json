{
  "info": {
    "_postman_id": "81f4ccae-f20b-4e2f-9377-61928c27ef5f",
    "name": "Agri Catalog Service - Product CRUD",
    "description": "Postman tests cho Product CRUD. Trước khi chạy folder CRUD, cấu hình accessToken của ADMIN, brandId và productCategoryId đang tồn tại.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "pm.test('Response follows ApiResponse format', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.be.an('object');",
          "    pm.expect(body).to.have.property('message');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9098/agri-catalog",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "brandId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productSlug",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public Products",
      "item": [
        {
          "name": "Get Published Products",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/products?brandId={{brandId}}&categoryId={{productCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["public", "products"],
              "query": [
                {
                  "key": "brandId",
                  "value": "{{brandId}}",
                  "disabled": true
                },
                {
                  "key": "categoryId",
                  "value": "{{productCategoryId}}",
                  "disabled": true
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Result only contains public products', function () {",
                  "    const result = pm.response.json().result;",
                  "    pm.expect(result).to.be.an('array');",
                  "    result.forEach(function (product) {",
                  "        pm.expect(product.publicationStatus).to.eql('PUBLISHED');",
                  "        pm.expect(product.moderationStatus).to.eql('NORMAL');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Products - CRUD Flow",
      "description": "Chạy theo thứ tự. Cần accessToken ADMIN, brandId và productCategoryId hợp lệ.",
      "item": [
        {
          "name": "01 - Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Result is an array', function () { pm.expect(pm.response.json().result).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Create Product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productSlug', 'postman-product-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Product is created with defaults', function () {",
                  "    const result = pm.response.json().result;",
                  "    pm.expect(result.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(result.brandId).to.eql(pm.collectionVariables.get('brandId'));",
                  "    pm.expect(result.categoryId).to.eql(pm.collectionVariables.get('productCategoryId'));",
                  "    pm.expect(result.slug).to.eql(pm.collectionVariables.get('productSlug'));",
                  "    pm.expect(result.publicationStatus).to.eql('DRAFT');",
                  "    pm.expect(result.moderationStatus).to.eql('NORMAL');",
                  "    pm.expect(result.featured).to.eql(false);",
                  "    pm.collectionVariables.set('productId', result.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brandId\": \"{{brandId}}\",\n  \"categoryId\": \"{{productCategoryId}}\",\n  \"name\": \"Sản phẩm kiểm thử Postman\",\n  \"slug\": \"{{productSlug}}\",\n  \"sku\": \"POSTMAN-001\",\n  \"registrationNumber\": \"REG-POSTMAN-001\",\n  \"manufacturerName\": \"Nông Thịnh Test\",\n  \"originCountry\": \"VN\",\n  \"shortDescription\": \"Sản phẩm tạm dùng cho kiểm thử CRUD\",\n  \"description\": \"Dữ liệu sẽ được soft delete ở cuối collection\",\n  \"ingredients\": \"Thành phần kiểm thử\",\n  \"usageInstruction\": \"Hướng dẫn kiểm thử\",\n  \"dosageInstruction\": \"Liều lượng kiểm thử\",\n  \"safetyInstruction\": \"Hướng dẫn an toàn kiểm thử\",\n  \"storageInstruction\": \"Bảo quản nơi khô ráo\",\n  \"warning\": \"Không dùng ngoài mục đích kiểm thử\",\n  \"form\": \"Dung dịch\",\n  \"unit\": \"chai\",\n  \"packageSpecification\": \"500 ml\",\n  \"purchaseUrl\": \"https://example.com/buy\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "response": []
        },
        {
          "name": "03 - Get Product By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Requested product is returned', function () {",
                  "    pm.expect(pm.response.json().result.id).to.eql(pm.collectionVariables.get('productId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{productCategoryId}}\",\n  \"name\": \"Sản phẩm kiểm thử Postman - đã cập nhật\",\n  \"slug\": \"{{productSlug}}\",\n  \"sku\": \"POSTMAN-002\",\n  \"registrationNumber\": \"REG-POSTMAN-002\",\n  \"manufacturerName\": \"Nông Thịnh Test\",\n  \"originCountry\": \"VN\",\n  \"shortDescription\": \"Nội dung đã cập nhật\",\n  \"description\": \"Dữ liệu cập nhật bởi Postman\",\n  \"ingredients\": \"Thành phần cập nhật\",\n  \"usageInstruction\": \"Hướng dẫn cập nhật\",\n  \"dosageInstruction\": \"Liều lượng cập nhật\",\n  \"safetyInstruction\": \"An toàn cập nhật\",\n  \"storageInstruction\": \"Bảo quản cập nhật\",\n  \"warning\": \"Cảnh báo cập nhật\",\n  \"form\": \"Bột\",\n  \"unit\": \"gói\",\n  \"packageSpecification\": \"1 kg\",\n  \"purchaseUrl\": \"https://example.com/buy-updated\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Product fields are updated', function () {",
                  "    const result = pm.response.json().result;",
                  "    pm.expect(result.name).to.eql('Sản phẩm kiểm thử Postman - đã cập nhật');",
                  "    pm.expect(result.sku).to.eql('POSTMAN-002');",
                  "    pm.expect(result.form).to.eql('Bột');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Filter Products By Brand And Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?brandId={{brandId}}&categoryId={{productCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "brandId",
                  "value": "{{brandId}}"
                },
                {
                  "key": "categoryId",
                  "value": "{{productCategoryId}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('All products match filters', function () {",
                  "    pm.response.json().result.forEach(function (product) {",
                  "        pm.expect(product.brandId).to.eql(pm.collectionVariables.get('brandId'));",
                  "        pm.expect(product.categoryId).to.eql(pm.collectionVariables.get('productCategoryId'));",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Delete response is correct', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.eql('Product deleted successfully');",
                  "    pm.expect(body.result).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Verify Deleted Product Is Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Product not found error is returned', function () {",
                  "    pm.expect(pm.response.json().code).to.eql('NOT_FOUND_PRODUCT_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
