<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0umf8j4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="brand-approval" name="Brand Approval" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Event_0li8c05" name="Start">
      <bpmn:outgoing>Flow_0jsp3vm</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="phone-verification" name="Phone Verification" camunda:candidateGroups="ticket:manage">
      <bpmn:incoming>Flow_0jsp3vm</bpmn:incoming>
      <bpmn:outgoing>Flow_06vr5co</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="request-documents" name="Request Documents" camunda:delegateExpression="${requestDocumentsDelegate}">
      <bpmn:incoming>Flow_1u6n1gu</bpmn:incoming>
      <bpmn:outgoing>Flow_0qf7iz4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="wait-initial-documents" name="Wait Initial Documents" messageRef="Message_31u40ch">
      <bpmn:incoming>Flow_0qf7iz4</bpmn:incoming>
      <bpmn:outgoing>Flow_0os7g3w</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="documents-review" name="Documents Review" camunda:candidateGroups="ticket:manage">
      <bpmn:incoming>Flow_0os7g3w</bpmn:incoming>
      <bpmn:incoming>Flow_1nke3hj</bpmn:incoming>
      <bpmn:outgoing>Flow_00s3vso</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0sdvnju" name="Documents OK?">
      <bpmn:incoming>Flow_00s3vso</bpmn:incoming>
      <bpmn:outgoing>Flow_15u02u8</bpmn:outgoing>
      <bpmn:outgoing>Flow_0l3ug42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="final-decision" name="Final Decision" camunda:candidateGroups="ticket:manage">
      <bpmn:incoming>Flow_15u02u8</bpmn:incoming>
      <bpmn:outgoing>Flow_06pyq9n</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="wait-revision-documents" name="Wait Revision Documents" messageRef="Message_0u43mid">
      <bpmn:incoming>Flow_14owt9u</bpmn:incoming>
      <bpmn:outgoing>Flow_1nke3hj</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_16wja7a" name="Phone Verified?">
      <bpmn:incoming>Flow_06vr5co</bpmn:incoming>
      <bpmn:outgoing>Flow_1u6n1gu</bpmn:outgoing>
      <bpmn:outgoing>Flow_0jzdgq5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0yzzm87" name="Approved?">
      <bpmn:incoming>Flow_06pyq9n</bpmn:incoming>
      <bpmn:outgoing>Flow_12brepq</bpmn:outgoing>
      <bpmn:outgoing>Flow_0hay8x1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="activate" name="Activate" camunda:delegateExpression="${activateDelegate}">
      <bpmn:incoming>Flow_12brepq</bpmn:incoming>
      <bpmn:outgoing>Flow_0j0iyiv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="reject-brand" name="Reject Brand" camunda:delegateExpression="${rejectBrandDelegate}">
      <bpmn:incoming>Flow_0jzdgq5</bpmn:incoming>
      <bpmn:incoming>Flow_0hay8x1</bpmn:incoming>
      <bpmn:outgoing>Flow_01aadkw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="request-revision" name="Request Revision" camunda:delegateExpression="${requestRevisionDelegate}">
      <bpmn:incoming>Flow_0l3ug42</bpmn:incoming>
      <bpmn:outgoing>Flow_14owt9u</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0jsp3vm" sourceRef="Event_0li8c05" targetRef="phone-verification" />
    <bpmn:sequenceFlow id="Flow_06vr5co" sourceRef="phone-verification" targetRef="Gateway_16wja7a" />
    <bpmn:sequenceFlow id="Flow_1u6n1gu" name="Yes" sourceRef="Gateway_16wja7a" targetRef="request-documents">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verificationResult == 'VERIFIED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0qf7iz4" sourceRef="request-documents" targetRef="wait-initial-documents" />
    <bpmn:sequenceFlow id="Flow_0os7g3w" sourceRef="wait-initial-documents" targetRef="documents-review" />
    <bpmn:sequenceFlow id="Flow_1nke3hj" sourceRef="wait-revision-documents" targetRef="documents-review" />
    <bpmn:sequenceFlow id="Flow_00s3vso" sourceRef="documents-review" targetRef="Gateway_0sdvnju" />
    <bpmn:sequenceFlow id="Flow_15u02u8" name="Yes" sourceRef="Gateway_0sdvnju" targetRef="final-decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentsOk == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0l3ug42" name="No" sourceRef="Gateway_0sdvnju" targetRef="request-revision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentsOk != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06pyq9n" sourceRef="final-decision" targetRef="Gateway_0yzzm87" />
    <bpmn:sequenceFlow id="Flow_14owt9u" sourceRef="request-revision" targetRef="wait-revision-documents" />
    <bpmn:sequenceFlow id="Flow_01aadkw" sourceRef="reject-brand" targetRef="Event_03ay5e8" />
    <bpmn:sequenceFlow id="Flow_0jzdgq5" name="No" sourceRef="Gateway_16wja7a" targetRef="reject-brand">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verificationResult != 'VERIFIED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12brepq" name="Yes" sourceRef="Gateway_0yzzm87" targetRef="activate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outcome == 'APPROVED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0hay8x1" name="No" sourceRef="Gateway_0yzzm87" targetRef="reject-brand">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outcome == 'REJECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0j0iyiv" sourceRef="activate" targetRef="Event_0zc4ka7" />
    <bpmn:endEvent id="Event_03ay5e8" name="Rejected">
      <bpmn:incoming>Flow_01aadkw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_0zc4ka7" name="Approved">
      <bpmn:incoming>Flow_0j0iyiv</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
