{
  "info": {
    "name": "Location Service",
    "description": "CRUD + query APIs for provinces and communes. Base URL includes context-path `/location`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9094/location" },
    { "key": "accessToken", "value": "" },
    { "key": "apiKey", "value": "ac96069461b53c2681274cab5d7dee8c14e3cc60570fce0cfeef6657b8660cf7" },
    { "key": "provinceId", "value": "HN" },
    { "key": "communeId", "value": "8fb35749-976d-49da-9f31-9d85a8bfa705" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Provinces (Public)",
      "item": [
        {
          "name": "Get All Provinces",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/provinces"
          }
        },
        {
          "name": "Get Province By ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/provinces/{{provinceId}}"
          }
        },
        {
          "name": "Get Communes By Province",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/provinces/{{provinceId}}/communes"
          }
        }
      ]
    },
    {
      "name": "Communes (Public)",
      "item": [
        {
          "name": "Get Commune By ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/communes/{{communeId}}"
          }
        }
      ]
    },
    {
      "name": "Provinces (Admin)",
      "item": [
        {
          "name": "Create Province",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"TEST\",\n  \"code\": \"99\",\n  \"name\": \"T\u1ec9nh Test\"\n}"
            },
            "url": "{{baseUrl}}/provinces"
          }
        },
        {
          "name": "Update Province",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"99\",\n  \"name\": \"T\u1ec9nh Test (\u0111\u00e3 \u0111\u1ed5i t\u00ean)\"\n}"
            },
            "url": "{{baseUrl}}/provinces/{{provinceId}}"
          }
        },
        {
          "name": "Delete Province",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/provinces/{{provinceId}}"
          }
        }
      ]
    },
    {
      "name": "Communes (Admin)",
      "item": [
        {
          "name": "Create Commune",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provinceId\": \"{{provinceId}}\",\n  \"code\": \"99999999\",\n  \"name\": \"Ph\u01b0\u1eddng Test\"\n}"
            },
            "url": "{{baseUrl}}/communes"
          }
        },
        {
          "name": "Update Commune (chuy\u1ec3n s\u00e1p nh\u1eadp)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provinceId\": \"HCM\",\n  \"code\": \"99999999\",\n  \"name\": \"Ph\u01b0\u1eddng Test (chuy\u1ec3n s\u00e1p nh\u1eadp)\"\n}"
            },
            "url": "{{baseUrl}}/communes/{{communeId}}"
          }
        },
        {
          "name": "Delete Commune",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/communes/{{communeId}}"
          }
        }
      ]
    },
    {
      "name": "Internal (X-API-KEY)",
      "item": [
        {
          "name": "Validate Address",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "X-API-KEY", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/internal/addresses/validate?provinceId={{provinceId}}&communeId={{communeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "addresses", "validate"],
              "query": [
                { "key": "provinceId", "value": "{{provinceId}}" },
                { "key": "communeId", "value": "{{communeId}}" }
              ]
            }
          }
        }
      ]
    }
  ]
}
