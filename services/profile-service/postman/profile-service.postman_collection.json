            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"brandName\": \"Nong Thinh Organic\",\n  \"description\": \"Thuong hieu nong san huu co\",\n  \"phone\": \"0241234567\",\n  \"officeProvinceId\": \"{{provinceId}}\",\n  \"officeCommuneId\": \"{{communeId}}\",\n  \"officeAddressDetail\": \"123 Pho Hang Bong\",\n  \"representativeName\": \"Le Van C\",\n  \"representativePhone\": \"0909123456\",\n  \"representativeEmail\": \"contact@nongthinh.vn\",\n  \"logoUrl\": \"https://cdn.example.com/brands/logo.png\",\n  \"bannerUrl\": \"https://cdn.example.com/brands/banner.png\",\n  \"websiteUrl\": \"https://nongthinh.vn\"\n}"
            },
